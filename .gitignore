# Arquivos de ambiente local.
.env
.env.*
!.env.example

# Ambientes virtuais Python.
venv/
env/
.venv/

# Caches e arquivos compilados do Python.
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Documentos enviados por usuários para impressão.
uploads/
*.pdf
*.docx
*.doc

# Imagens enviadas por usuários, mantendo somente os logos oficiais do projeto.
*.png
*.jpg
*.jpeg
!static/logo/**

# Pastas de editores e arquivos criados pelo sistema operacional.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs de execução.
*.log
