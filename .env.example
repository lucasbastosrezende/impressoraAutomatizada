# Configurações do servidor Flask.
FLASK_APP=servidor:aplicacao
FLASK_ENV=development
PORTA=5000
ENDERECO_SERVIDOR=0.0.0.0

# Configurações da impressora.
# Use o nome exatamente como aparece no Windows.
IMPRESSORA_PADRAO="Nome Da Impressora Aqui"

# Caminho do SumatraPDF.
# Deixe vazio para usar a versão incluída em ./SumatraPDF/SumatraPDF.exe.
CAMINHO_SUMATRA=

# Pix dinâmico via Mercado Pago.
# Preencha somente se quiser verificação automática do pagamento.
TOKEN_MERCADO_PAGO=

# Pix estático usado quando o Mercado Pago não está configurado.
CHAVE_PIX=
NOME_RECEBEDOR_PIX=Capital Papelaria
CIDADE_RECEBEDOR_PIX=Brasilia
